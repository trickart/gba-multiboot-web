{
  "name": "gba-multiboot-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "gen:protocol": "cd .. && swift run --package-path . ProtocolGen > web/src/protocol.generated.ts",
    "build:wasm": "../scripts/build-wasm.sh",
    "prepare:core": "npm run gen:protocol && npm run build:wasm"
  },
  "devDependencies": {
    "@types/w3c-web-serial": "^1.0.7",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "license": "MIT"
}
